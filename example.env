TOKEN=<Discord Token>
APPLICATION_OUTPUT_CHANNEL_ID=<Discord Channel ID>
GUILD_ID=<Discord Server ID>
SUBMISSION_ENDPOINT=<Server Webhook Endpoint>
DATABASE_URL=<Database Connection URL>
BACKEND_URL=<Backend API URL>
API_TOKEN=<API Token>
BACKEND_API_KEY=<Backend API key, sent as X-API-Key>

# Optional trial coordination. Keep false until the channels/cadence are approved.
TRIAL_BOARD_ENABLED=false
TRIAL_BOARD_CONFIG=private/trial-board.toml
